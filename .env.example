# Copy to .env and fill in. Every setting is read with the BU_ prefix (see core/config.py).

# OpenAI key (OPENAI_API_KEY is also accepted)
BU_OPENAI_API_KEY=

# Models: the big one only drives `decide`/`plan`/`reflect`; the small one answers Extract queries.
BU_MODEL_DECIDE=gpt-4.1
BU_MODEL_SMALL=gpt-4.1-mini
# Prices in USD per 1M tokens [input, output] for models not in core/costs.py, as JSON:
# BU_MODEL_PRICES={"gpt-5.4-mini": [0.75, 4.5]}

# Run limits (the three loop guards)
BU_MAX_STEPS=25
BU_BUDGET_USD=0.15
BU_RUN_TIMEOUT_S=300

# API: key → tenant as JSON (keys ≥ 16 chars). The API refuses requests while this is empty.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
BU_API_KEYS={}
BU_RATE_LIMIT_PER_MINUTE=120
BU_MAX_ACTIVE_RUNS_PER_TENANT=3
BU_DEBUG_PAGE=true

# Secrets for {{SECRET:name}} placeholders: 32 random bytes, base64. Unset = /v1/secrets is off.
# Generate: python -c "from core.secrets import generate_key; print(generate_key())"
BU_SECRETS_KEY=
# CLI/evals only (the API stores per-tenant secrets via /v1/secrets), as JSON:
# BU_LOCAL_SECRETS={"shop_pw": {"value": "...", "domains": ["login.shop.example"]}}

# Monthly spend caps in USD (UTC calendar month); unset = no cap.
# BU_MONTHLY_BUDGET_USD=50
# BU_TENANT_MONTHLY_BUDGET_USD=20

# Privacy and retention
BU_REDACT_PII=true
BU_SCREENSHOT_TTL_S=86400
BU_CHECKPOINT_TTL_S=86400
# BU_RUN_RETENTION_DAYS=30

# Browser
# Drive a visible Chromium on the host (see README) instead of the container's headless one:
# BU_BROWSER_WS_ENDPOINT=ws://host.docker.internal:3010/<token>
# Egress proxy (SSRF guard for all browser traffic). On by default; with a remote browser it
# is the one devtools.browser_host runs beside it.
BU_EGRESS_PROXY=true
BU_HEADLESS=true
BU_MAX_CONTEXTS=4
BU_BLOCK_RESOURCES=true
# Health probe: a browser that doesn't answer twice in a row is restarted.
BU_BROWSER_PROBE_INTERVAL_S=30
BU_BROWSER_PROBE_TIMEOUT_S=10

# Set by docker/compose.yml inside the container; only needed when running on the host.
# BU_DATABASE_URL=postgresql://bu:bu@localhost:5432/bu
# BU_REDIS_URL=redis://localhost:6379/0
# BU_SESSIONS_DIR=.data/sessions

# Tracing (Langfuse): on when both keys are set. From a container, reach the host's Langfuse
# at host.docker.internal.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://host.docker.internal:7453

# Replicas: unique id per replica (default: the hostname), lease and drain times.
# BU_REPLICA_ID=
BU_RUN_LEASE_S=30
BU_DRAIN_TIMEOUT_S=60

BU_LOG_LEVEL=INFO
BU_LOG_JSON=true
